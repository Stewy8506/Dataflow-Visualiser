{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeMapper",
  "version": "1.0.0",
  "identifier": "com.dasan.dataflow-visualiser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dataflow-visualiser",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.github.com/repos/Stewy8506/Dataflow-Visualiser/releases/latest"
      ],
      "pubkey": "UPDATE_PUBKEY_PLACEHOLDER"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}