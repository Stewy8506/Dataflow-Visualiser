{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "opener:default",
    "dialog:default",
    "store:default",
    "fs:default",
    {
      "identifier": "fs:allow-read",
      "allow": ["**"]
    },
    {
      "identifier": "fs:allow-write",
      "allow": ["**"]
    }
  ]
}